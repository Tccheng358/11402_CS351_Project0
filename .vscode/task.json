{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build C++ Project",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/Src/*.cpp",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles all .cpp files in the Src folder."
        }
    ]
}